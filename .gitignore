tools/test/prof_*/
tools/test/*.png
tools/test/ref.caf

__pycache__/
*.pyc
.idea/

# side-by-side dumps written by tools/review_no.py
_review/
# photo candidates downloaded by tools/commons.py
_photos/

# API keys (tools/tts.py reads OPENROUTER_API_KEY from here)
.env

